{
  "name": "zerobleed",
  "version": "0.1.0",
  "private": true,
  "description": "ZeroBleed: a need-to-know context broker for agentic audits, built on Zetaris, Meterless Nightshift and the Markovian engine.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "data": "tsx src/dataServer.ts",
    "setup:zetaris": "tsx scripts/setupZetaris.ts",
    "audit": "tsx src/cli.ts",
    "conformance": "tsx scripts/conformance.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "SAMPLE_MODE=true DATA_PORT=8798 node --import tsx --test tests/*.test.ts && npm run -s conformance",
    "report": "tsx scripts/report.ts",
    "pdf": "tsx scripts/pdf.ts",
    "build:site": "SAMPLE_MODE=true DATA_PORT=8791 tsx scripts/buildSite.ts",
    "publish:site": "git subtree split --prefix site -b gh-pages-tmp && git push -f origin gh-pages-tmp:gh-pages && git branch -D gh-pages-tmp"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "ffmpeg-static": "^5.2.0",
    "marked": "^14.1.3",
    "playwright-core": "^1.48.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
